# syntax=docker/dockerfile:1
# Lab 03 — Base "alpine": node:22-alpine (musl libc + busybox + apk)
# Build: docker build -f hands-on/lab03-base-images/Dockerfile.alpine -t handson/backend:alpine backend
#
# Atenção: o builder também é alpine. Módulos nativos compilados contra glibc
# (builder Debian) não carregam em musl — por isso builder e runtime usam a mesma libc.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
USER node
EXPOSE 3000 9464
CMD ["node", "dist/main.js"]
