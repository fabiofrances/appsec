# syntax=docker/dockerfile:1
# Lab 03 — Base "distroless": gcr.io/distroless/nodejs22-debian12:nonroot
# Build: docker build -f hands-on/lab03-base-images/Dockerfile.distroless -t handson/backend:distroless backend
#
# Sem shell, sem gerenciador de pacotes, sem wget/curl:
#  - ENTRYPOINT da imagem já é o node → CMD recebe só o script
#  - não dá para usar HEALTHCHECK com wget (healthcheck fica no orquestrador)
#  - debug: docker debug / imagem :debug (tem busybox) / container efêmero
FROM node:22 AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM gcr.io/distroless/nodejs22-debian12:nonroot AS production
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
EXPOSE 3000 9464
CMD ["dist/main.js"]
